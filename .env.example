# ─── Agent.OS Environment Configuration ───────────────────────────────
# Copy this file to the project root as ".env" and fill in your keys.
#
#   cp setup/.env.example .env
#
# All keys below are REQUIRED unless marked optional.

# ─── Gemini API ────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Optional: Local AI Providers ─────────────────────────────────────
# NVIDIA (cloud) — get a key at https://build.nvidia.com
NVIDIA_API_KEY=
