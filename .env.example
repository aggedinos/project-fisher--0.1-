# Copy this file to .env for local development. Never commit .env.
# Ollama is the default and needs no API key. Add a key only for an optional cloud provider.
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Optional Fisher settings (uncomment only when needed).
# FISHER_PROVIDER=ollama             # ollama, gemini, nvidia
# FISHER_MODEL=llama3.2-vision
# FISHER_PERMISSION_MODE=safe        # auto, safe, supervised
# FISHER_HEADLESS=true
# FISHER_PROFILE=temporary           # temporary or persistent Fisher-owned profile
# FISHER_EXECUTABLE_PATH=/path/to/chromium
# FISHER_DATA_DIR=/path/to/user-data
# FISHER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# FISHER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# FISHER_MAX_STEPS=30
# FISHER_ALLOW_PRIVATE_NETWORK=false
